generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  timezone            String    @default("America/Los_Angeles")
  onboardedAt         DateTime?
  onboardingStep      String    @default("company")
  onboardingProgress  String    @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  users          User[]
  properties     Property[]
  vendors        Vendor[]
  sops           Sop[]
  sows           Sow[]
  turnovers      Turnover[]
  inventory      InventoryItem[]
  issues         Issue[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  backgroundJobs BackgroundJob[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("PROPERTY_MANAGER")
  companyId    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company       Company?       @relation(fields: [companyId], references: [id])
  sessions      Session[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Property {
  id                   String    @id @default(cuid())
  companyId            String
  name                 String
  unitCode             String
  address              String
  city                 String
  state                String
  unitType             String    @default("apartment")
  bedrooms             Int       @default(1)
  bathrooms            Float     @default(1)
  maxGuests            Int       @default(2)
  calendarUrl          String?
  bookingSource        String    @default("manual")
  calendarSyncedAt     DateTime?
  calendarStatus       String    @default("not_connected")
  sopId                String?
  sowId                String?
  defaultVendorId      String?
  photoRequirementsJson String   @default("[]")
  restockDefaultsJson  String    @default("[]")
  accessNotes          String?
  turnoverBufferMins   Int       @default(60)
  sameDayTurnover      Boolean   @default(true)
  active               Boolean   @default(true)
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sop           Sop?            @relation(fields: [sopId], references: [id])
  sow           Sow?            @relation(fields: [sowId], references: [id])
  defaultVendor Vendor?         @relation("PropertyDefaultVendor", fields: [defaultVendorId], references: [id])
  bookings      Booking[]
  turnovers     Turnover[]
  inventory     InventoryItem[]

  @@unique([companyId, unitCode])
}

model Vendor {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String
  phone     String?
  type      String   @default("CLEANER")
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments        Turnover[]
  defaultProperties  Property[] @relation("PropertyDefaultVendor")

  @@unique([companyId, email])
}

model Booking {
  id         String   @id @default(cuid())
  propertyId String
  externalId String?
  guestName  String?
  checkIn    DateTime
  checkOut   DateTime
  source     String   @default("manual")
  createdAt  DateTime @default(now())

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  turnover Turnover?

  @@unique([propertyId, externalId])
}

model Sop {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  version     Int      @default(1)
  contentJson String   @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  properties Property[]
  turnovers  Turnover[]
}

model Sow {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  description   String?
  standardScope String
  addOnsJson    String   @default("[]")
  slaMinutes    Int      @default(240)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  properties Property[]
  turnovers  Turnover[]
}

model Turnover {
  id              String    @id @default(cuid())
  companyId       String
  propertyId      String
  bookingId       String?   @unique
  sopId           String?
  sowId           String?
  vendorId        String?
  status          String    @default("SCHEDULED")
  priority        String    @default("NORMAL")
  windowStart     DateTime
  windowEnd       DateTime
  deadlineAt      DateTime
  photosRequired  Int       @default(4)
  photosUploaded  Int       @default(0)
  photosVerified  Int       @default(0)
  ownerNotifiedAt DateTime?
  escalatedAt     DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking?  @relation(fields: [bookingId], references: [id])
  sop      Sop?      @relation(fields: [sopId], references: [id])
  sow      Sow?      @relation(fields: [sowId], references: [id])
  vendor   Vendor?   @relation(fields: [vendorId], references: [id])
  issues   Issue[]
}

model Issue {
  id          String    @id @default(cuid())
  companyId   String
  turnoverId  String?
  title       String
  description String
  severity    String    @default("MEDIUM")
  status      String    @default("OPEN")
  category    String    @default("damage")
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  turnover Turnover? @relation(fields: [turnoverId], references: [id])
}

model InventoryItem {
  id           String   @id @default(cuid())
  companyId    String
  propertyId   String?
  name         String
  category     String   @default("supplies")
  quantity     Int      @default(0)
  reorderLevel Int      @default(5)
  unit         String   @default("each")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  companyId String
  userId    String?
  title     String
  body      String
  type      String    @default("info")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id])
}

model BackgroundJob {
  id          String    @id @default(cuid())
  companyId   String?
  type        String
  payloadJson String    @default("{}")
  status      String    @default("PENDING")
  runAt       DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  company Company? @relation(fields: [companyId], references: [id])
}
