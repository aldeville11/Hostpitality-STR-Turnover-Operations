# Hostpitality environment configuration
# Copy to .env.local for local development. Never commit real secrets.

# PostgreSQL connection (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hostpitality_dev?schema=public"

# Isolated test database — required for npm test (must not be staging/production)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hostpitality_test?schema=public"

# Session HMAC pepper — rotating this invalidates all sessions (required in production)
SESSION_PEPPER="generate-a-long-random-secret"

# Cron job processor secret for POST /api/jobs/process (required in production)
CRON_SECRET="generate-a-long-random-secret"
# Optional previous secret during rotation window only
CRON_SECRET_PREVIOUS=""

# Redis for distributed rate limiting (required in production)
REDIS_URL="redis://127.0.0.1:6379"
RATE_LIMIT_PEPPER="generate-a-long-random-secret"

# Logging and jobs
LOG_LEVEL="info"
JOB_BATCH_SIZE="25"
# Seconds before a RUNNING job claim may be reclaimed (min 60, max 3600, default 900)
JOB_LEASE_SECONDS="900"

# Trusted proxy mode for rate-limit IP identity: none | vercel | single-hop
# Leave unset on Vercel (auto). Use single-hop only behind a sanitizing reverse proxy.
TRUST_PROXY=""

# Application base URL when generating absolute links server-side
APP_BASE_URL="http://localhost:3000"

# Development only — never enable in production
ALLOW_AUTH_BYPASS="false"
ALLOW_DEMO_SEED="false"
SEED_CONFIRM=""
# Demo seed allows only localhost/loopback/host.docker.internal/postgres/*.local by default.
# RFC1918 hosts require DEMO_SEED_ALLOWED_HOSTS=<exact-host> and SEED_CONFIRM_REMOTE=DESTROY_REMOTE_SEED
DEMO_SEED_ALLOWED_HOSTS=""
SEED_CONFIRM_REMOTE=""
# Demo seed also refuses remote/staging/production DATABASE_URL hosts.

# DEPRECATED: AUTH_SECRET is unused. Sessions use SESSION_PEPPER + opaque cookies.
# AUTH_SECRET="deprecated-unused"
